      "phone_formatted",
      "phone_sanitized",
      "phone_state",
      "priority",
      "probability",
      "project_count",
      "quotation_count",
      "referred",
      "registration_count",
      "registration_ids",
      "reveal_iap_credits",
      "reveal_ip",
      "reveal_rule_id",
      "rotting_days",
      "sale_amount_total",
      "sale_order_count",
      "show_enrich_button",
      "source_id",
      "stage_id",
      "state_id",
      "street",
      "street2",
      "tag_ids",
      "task_count",
      "team_id",
      "type",
      "user_company_ids",
      "user_id",
      "utm_reference",
      "visitor_page_count",
      "visitor_sessions_count",
      "website",
      "won_status",
      "zip"
    ],
    "widgets": [
